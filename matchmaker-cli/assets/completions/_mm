#compdef mm

autoload -U is-at-least

_mm() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config=[]:PATH:_files' \
'*-o+[]:PATH:_files' \
'*--override=[]:PATH:_files' \
'--group-prefix=[Specify a prefix that indicates a line is a group header]:PREFIX:_default' \
'--download=[Download presets from GitHub. Optionally specify a subfolder]::FOLDER:_default' \
'-d+[Display documentation]:DOC:(options binds template other)' \
'--doc=[Display documentation]:DOC:(options binds template other)' \
'*--media=[Enable native terminal media previews (images, videos, PDFs) using ratatui-image and set properties. Examples\: --media --media size\:s --media size\:256 type\:kitty --media size\:xl]::PROP:_default' \
'*--color=[Colourise the UI with fzf-style key\:value pairs (comma-separated). Example\: --color border\:#cba6f7,hl-fg\:#a6e3a1,nav\:#89b4fa Keys\: fg, bg, hl-fg, hl-bg, border, label, preview-border, preview-label, list-border, list-label, input-border, input-label, header-border, header-label, nav, selected-fg, selected-bg, selected-prefix, unselected-prefix, spinner, yank, cut, symlink]:SPEC:_default' \
'*--nav=[Enable navigation mode and set properties. Examples\: --nav --nav bar blink\:slow --nav bar\:plain action-bar color\:#a6e3a1 marker\:'\''>'\'' bold --nav action-bar\:double]::PROP:_default' \
'*--nav-bind=[Navigation-mode key bindings in the form "char\:action". Example\: --nav-bind '\''h\:ChDir(..)'\'' --nav-bind '\''l\:ChDir({=});Reload'\'']:BIND:_default' \
'--dump-config[]' \
'-F[]' \
'--test-keys[]' \
'--last-key[]' \
'--no-read[Force the default command to run]' \
'(-v)*-q[Reduce the verbosity level]' \
'(-q)*-v[Increase the verbosity level]' \
'--sort[Sort input lines alphabetically before injecting into the picker]' \
'--icons[Prepend a Nerd Font file-type icon before each result row]' \
'--symlink-target[Append symlink target path after the first column when the entry is a symlink]' \
'-h[Print help]' \
'--help[Print help]' \
'*::args -- args passed to the start command:_default' \
&& ret=0
}

(( $+functions[_mm_commands] )) ||
_mm_commands() {
    local commands; commands=()
    _describe -t commands 'mm commands' commands "$@"
}

if [ "$funcstack[1]" = "_mm" ]; then
    _mm "$@"
else
    compdef _mm mm
fi
